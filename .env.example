# Any OpenAI-compatible Chat Completions endpoint.
BLINDFUGUE_API_KEY=your-model-api-key
BLINDFUGUE_BASE_URL=https://your-openai-compatible-endpoint/v1
BLINDFUGUE_MODEL=your-model-name

# search + google_scholar use Serper; visit uses Jina Reader.
SERPER_API_KEY=
JINA_API_KEY=

# Optional generation settings.
BLINDFUGUE_TEMPERATURE=0.3
BLINDFUGUE_MAX_TOKENS=1000
BLINDFUGUE_ENABLE_THINKING=false
BLINDFUGUE_MAX_TOOL_ROUNDS=4
BLINDFUGUE_TIMEOUT=120
